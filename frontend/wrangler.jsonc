{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recall-demo-frontend",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "recall.samneet.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
