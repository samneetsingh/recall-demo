# Copy this file to backend/.env and put the values in it.
RECALL_API_KEY=
OPENAI_API_KEY=

# Workspace verification secret to verify dashboard events and the real-time
# events. Workspace uses one secret for both.
RECALL_WEBHOOK_SECRET=whsec_

# The Recall host of your region.
# RECALL_API_BASE=https://us-west-2.recall.ai

# Where Recall reaches this backend. Change it for a tunnel to a local machine.
# PUBLIC_BASE_URL=https://recall-api.ss-ubuntu-01.net

# The name of the bot in the meeting, and the timeout of the create-bot call.
# RECALL_BOT_NAME=FIRY Intake Assistant
# RECALL_TIMEOUT_SECONDS=30.0

# The SQLite file. The default is the path in the container, which is a Docker named volume.
# DB_PATH=./data/recall_demo.sqlite3

# CORS values
# CORS_ORIGINS=["https://recall.samneet.com","http://localhost:8787"]
# CORS_METHODS=["GET","POST","OPTIONS"]
# CORS_HEADERS=["Authorization","Content-Type"]
